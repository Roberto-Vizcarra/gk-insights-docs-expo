# Copy to .env and adjust. .env is gitignored.

# 8080/8081/8000/3000/8888 are heavily contested on a dev machine. These are not.
WP_PORT=8420
ADMINER_PORT=8421

# Bump if prod runs a different WP/PHP pair. Match prod for faithful testing.
WP_IMAGE_TAG=6.8-php8.2-apache

DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress
DB_ROOT_PASSWORD=root

# MUST match the prefix in the prod dump, or WP will not see the imported data.
# Check the dump: the tables will be named e.g. `wp_posts` or `wpxx_posts`.
DB_TABLE_PREFIX=wp_

# The production URL to rewrite out of the imported database.
PROD_URL=https://help.gitkraken.com
